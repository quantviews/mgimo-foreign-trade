# Copy to demo/.env on the VPS and fill in. Never commit the real .env.

# DeepSeek (OpenAI-compatible). The account key.
MGIMO_DEMO_DEEPSEEK_API_KEY=

# A demo-plan API key for tool calls (issue once on the 'demo' plan; the chat
# uses this single key for everyone, per-user limits are counted separately).
MGIMO_DEMO_SERVICE_API_KEY=

# Same Postgres as the API (schema api). On the Superset network use the service
# name, e.g. postgresql://superset:...@superset-postgres-1:5432/tradeapi
MGIMO_DEMO_POSTGRES_DSN=

# Data API reachable inside the docker network (default is fine).
MGIMO_DEMO_API_BASE=http://trade-api:8000

# Public site base, for verification links.
MGIMO_DEMO_SITE_BASE_URL=https://nts.mgimo.ru

# Random string to sign session cookies (e.g. `openssl rand -hex 32`).
MGIMO_DEMO_SESSION_SECRET=

# Verification email sender + SMTP. For Yandex 360 (fief.ru): host smtp.yandex.ru,
# port 465 (SSL), user = full address, password = an app password (Yandex requires
# an app-specific password with IMAP/SMTP access enabled, not the account password).
MGIMO_DEMO_MAIL_FROM=research@fief.ru
# Team notification on each registration (empty disables it).
MGIMO_DEMO_NOTIFY_EMAIL=m_salihov@fief.ru
MGIMO_DEMO_SMTP_HOST=smtp.yandex.ru
MGIMO_DEMO_SMTP_PORT=465
MGIMO_DEMO_SMTP_USER=research@fief.ru
MGIMO_DEMO_SMTP_PASSWORD=

# Limits.
MGIMO_DEMO_TURN_LIMIT=10
MGIMO_DEMO_DAILY_BUDGET=500

# Superset docker network name (same value as the API's compose uses).
SUPERSET_NETWORK=superset_default
