# Copy to api/.env on the VPS and fill in. Never commit the real .env.

# Superset's Postgres — the API stores tokens/audit in schema `api` here.
# Host = the Postgres service name on Superset's Docker network (e.g. 'db' or
# 'superset_db'); check `docker compose ps` in the Superset stack.
MGIMO_API_POSTGRES_DSN=postgres://superset:PASSWORD@db:5432/superset

# Absolute path on the HOST to the DuckDB serving file (the one Superset reads),
# e.g. /opt/superset/data/duckdb/unified_trade_data.duckdb
DUCKDB_HOST_PATH=/CHANGE/ME/unified_trade_data.duckdb

# Superset's Docker network name (docker network ls), e.g. superset_default
SUPERSET_NETWORK=superset_default
