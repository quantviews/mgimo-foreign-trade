# Copy to api/.env on the VPS and fill in the secret. Never commit the real .env.
# Values below are pre-filled for the project VPS (Superset stack `~/superset`,
# network superset_default, Postgres service `postgres`, DuckDB host dir /srv/duckdb).

# Superset's Postgres — the API stores tokens/audit in schema `api` here.
# Host = the Postgres SERVICE name on Superset's network: `postgres`.
# Get POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB with:
#   docker exec superset-postgres-1 printenv POSTGRES_USER POSTGRES_PASSWORD POSTGRES_DB
MGIMO_API_POSTGRES_DSN=postgres://USER:PASSWORD@postgres:5432/DBNAME

# Absolute path on the HOST to the DuckDB serving file Superset reads
# (host /srv/duckdb -> container /data/duckdb). Confirm the filename: ls /srv/duckdb/
DUCKDB_HOST_PATH=/srv/duckdb/unified_trade_data.duckdb

# Superset's Docker network (docker network ls).
SUPERSET_NETWORK=superset_default
